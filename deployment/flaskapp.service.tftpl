[Unit]
Description=Flask Application
After=network.target
# Nothing to run until GitHub Actions deploys the first release.
ConditionPathExists=${app_path}/current/backend/main.py

[Service]
User=flaskapp
WorkingDirectory=${app_path}/current/backend
EnvironmentFile=/etc/personalwebsite/secrets.env
Environment="FLASK_ENV=production"
Environment="PERSONALWEBSITE_INSTANCE_PATH=${data_path}"
Environment="PORT=${backend_port}"
ExecStart=${app_path}/current/backend/.venv/bin/python3 main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Releases are root-owned and read-only; runtime data is the only writable path.
ProtectSystem=strict
ReadWritePaths=${data_path}
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

#!/bin/bash
# The VM's startup script (the startup-script metadata key in main.tf), run as root on
# every boot. To apply a config change without rebooting, run it by hand:
#   sudo google_metadata_script_runner startup

# google_metadata_script_runner already forwards stdout to the serial console,
# so only tee to the local log file to avoid every line appearing twice.
exec > >(tee -a /var/log/startup-script.log) 2>&1
set -euo pipefail

PROVISIONED_MARKER=${data_path}/.provisioned
# Files write_file replaced in this run, for apply_changes.
CHANGED=()
# The previous Nginx files, so check_nginx can restore them.
BACKUPS="$(mktemp -d)"
trap 'rm -rf -- "$BACKUPS"' EXIT
# Set by bootstrap_release when the bucket is empty (first-time setup), for mark_ready.
NO_RELEASE_PUBLISHED=false

# Packages, the runtime user, and its directories. First boot only.
provision() {
	export DEBIAN_FRONTEND=noninteractive
	# man-db rebuilds its index after every package install, which is slow on an e2-micro.
	apt-get remove -yq man-db
	apt-get autoremove -yq
	apt-get update -yq
	apt-get install -yq python3.13 python3.13-venv nginx curl ca-certificates unattended-upgrades
	# The package starts Nginx on Debian's default site (0.0.0.0:80), and a reload can't
	# rebind that to our 127.0.0.1:80. Keep it down until it starts on our config.
	systemctl stop nginx

	# A second update, since fetching Cloudflare's key needs the curl installed above.
	install -d -m 755 /usr/share/keyrings
	curl -fsSL -o /usr/share/keyrings/cloudflare-main.gpg https://pkg.cloudflare.com/cloudflare-main.gpg
	echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" \
		> /etc/apt/sources.list.d/cloudflared.list
	apt-get update -yq
	apt-get install -yq cloudflared

	if ! id -u flaskapp >/dev/null 2>&1; then
		useradd --system --no-create-home --shell /usr/sbin/nologin flaskapp
	fi
	# Releases are root-owned; flaskapp can only write its runtime data.
	install -d -m 755 -o root -g root ${app_path} ${app_path}/releases
	install -d -m 700 -o flaskapp -g flaskapp ${data_path}
}

# Replace file $1 with stdin (mode $2, owner $3) if the contents differ, and record it in
# CHANGED. Written to a temp file beside it and renamed, so nothing reads a partial file.
write_file() {
	local path="$1" mode="$2" owner="$3" tmp
	mkdir -p "$(dirname "$path")"
	# The leading dot keeps sudo, systemd, and Nginx from loading the temp file.
	tmp="$(mktemp "$(dirname "$path")/.$(basename "$path").XXXXXX")"
	cat > "$tmp"
	chown "$owner" "$tmp"
	chmod "$mode" "$tmp"

	if [[ -f "$path" ]] && cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
		# Fix drift in place: replacing the file would bump its mtime, which systemd
		# reads as a changed unit.
		chown "$owner" "$path"
		chmod "$mode" "$path"
		return 0
	fi
	case "$path" in
		# A broken rule would lock everyone out of sudo, so check it before it's live.
		/etc/sudoers.d/*)
			if ! visudo -cf "$tmp"; then
				rm -f "$tmp"
				echo "ERROR: invalid sudoers rule for $path; kept the current one." >&2
				return 1
			fi
			;;
		/etc/nginx/*)
			if [[ -f "$path" ]]; then
				mkdir -p "$BACKUPS$(dirname "$path")"
				cp -p "$path" "$BACKUPS$path"
			fi
			;;
	esac
	mv -f "$tmp" "$path"
	CHANGED+=("$path")
	echo "Updated $path"
}

# The files in main.tf's vm_files, rendered in by Terraform. Read through < <(...), not a
# pipe, so write_file runs in this shell and its CHANGED entries survive.
install_vm_files() {
%{ for path, f in vm_files ~}
	write_file ${path} ${f.mode} root:root < <(base64 --decode <<< '${base64encode(f.content)}')
%{ endfor ~}
}

# A bad Nginx config would take the site down at the next reload or boot. Test it before
# anything reloads, and if it fails, restore the previous files and stop.
check_nginx() {
	local path nginx_files=()
	for path in "$${CHANGED[@]}"; do
		if [[ "$path" == /etc/nginx/* ]]; then
			nginx_files+=("$path")
		fi
	done
	if (( $${#nginx_files[@]} == 0 )) || nginx -t; then
		return 0
	fi

	for path in "$${nginx_files[@]}"; do
		if [[ -f "$BACKUPS$path" ]]; then
			cp -p "$BACKUPS$path" "$path"
		else
			rm -f "$path"
		fi
	done
	echo "ERROR: nginx -t failed; restored the previous Nginx config and stopped." >&2
	exit 1
}

# Every boot, so rotating a secret only needs a reboot. gcloud ships with Google's
# Debian images and runs as the VM's service account, in the VM's project.
refresh_secrets() {
	local flask_key tunnel_token
	# Assigned on their own lines so a gcloud failure stops the script (set -e) instead
	# of writing an empty secret.
	flask_key="$(gcloud secrets versions access "${secret_version_flask}" --secret="${secret_name_flask}")"
	tunnel_token="$(gcloud secrets versions access latest --secret="${secret_name_cloudflare_tunnel_token}")"
	write_file /etc/personalwebsite/secrets.env 640 root:flaskapp <<< "SECRET_KEY=$flask_key"
	write_file /etc/cloudflared/tunnel.env 600 root:root <<< "TUNNEL_TOKEN=$tunnel_token"
}

# Make each changed file take effect, by where it lives. Files not listed here (the apt
# config, sudoers rule, deploy script) are read fresh on every use.
apply_changes() {
	local path daemon_reload=false reload_nginx=false
	local -A restart=()
	for path in "$${CHANGED[@]}"; do
		case "$path" in
			/etc/systemd/system/*)
				daemon_reload=true
				restart[$(basename "$path")]=1
				;;
			/etc/personalwebsite/*) restart[flaskapp.service]=1 ;;
			/etc/cloudflared/*) restart[cloudflared.service]=1 ;;
			/etc/nginx/*) reload_nginx=true ;;
			/etc/sysctl.d/*) sysctl -p "$path" ;;
		esac
	done

	if [[ "$daemon_reload" == true ]]; then
		systemctl daemon-reload
	fi
	# try-: units that aren't running yet (first boot) start at the end of the script.
	if (( $${#restart[@]} )); then
		systemctl try-restart "$${!restart[@]}"
	fi
	if [[ "$reload_nginx" == true ]]; then
		systemctl try-reload-or-restart nginx
	fi
}

# Install the last release Deploy published (deploy.yaml), so a new VM in a swap
# serves the site without a manual deploy. Returns 0 if none is published yet.
bootstrap_release() {
	local object="gs://${release_bucket}/latest.tar.gz"
	local fields sha checksum generation
	# `list`, not `describe`: a missing object prints nothing instead of failing,
	# so only real errors return 1. (Callers' `||` turns off `set -e` in here.)
	fields="$(gcloud storage objects list "$object" \
		--format='value(custom_fields.git-sha,custom_fields.sha256,generation)')" || return 1
	if [[ -z "$fields" ]]; then
		echo "No release published to gs://${release_bucket} yet."
		NO_RELEASE_PUBLISHED=true
		return 0
	fi
	read -r sha checksum generation <<< "$fields"

	# Pinned to the generation just read, so a concurrent deploy can't pair this
	# metadata with another release's bytes. The deploy script checks the checksum.
	# It also starts cloudflared once the release is healthy.
	echo "Installing published release $sha..."
	gcloud storage cat "$object#$generation" | /usr/local/sbin/personalwebsite-deploy "$sha" "$checksum"
}

# Tell Terraform (vm_ready in main.tf) that this VM serves a release through the tunnel,
# with a guest attribute: the release's commit SHA, or `none` before the first release.
# A swap destroys the old VM only after the new one sets it.
mark_ready() {
	local value tries=0
	if [[ -e ${app_path}/current ]]; then
		value="$(basename "$(readlink ${app_path}/current)")"
		until curl -fsS -o /dev/null http://127.0.0.1:20241/ready; do
			if (( ++tries >= 24 )); then
				echo "ERROR: serving $value, but cloudflared hasn't connected after 2 minutes; not marking ready." >&2
				return 1
			fi
			sleep 5
		done
	elif [[ "$NO_RELEASE_PUBLISHED" == true ]]; then
		value=none
	else
		echo "ERROR: no release is active; not marking ready." >&2
		return 1
	fi
	curl -fsS -X PUT --data "$value" -H 'Metadata-Flavor: Google' \
		http://metadata.google.internal/computeMetadata/v1/instance/guest-attributes/personalwebsite/ready
	echo "Marked ready: $value"
}

echo "===== Startup Script Begin ====="

if [[ ! -f "$PROVISIONED_MARKER" ]]; then
	echo "First boot: installing packages..."
	provision
fi

echo "Installing config files..."
install_vm_files
check_nginx
echo "Fetching runtime secrets from Secret Manager..."
refresh_secrets
apply_changes
systemctl enable flaskapp nginx cloudflared cloudflared-restart.path
# --no-block: a unit that fails to start (say, cloudflared during a Cloudflare outage)
# shows in systemctl status instead of stopping the script before the release bootstrap.
# flaskapp and cloudflared are skipped until a release exists (ConditionPathExists).
systemctl start --no-block flaskapp nginx cloudflared cloudflared-restart.path
touch "$PROVISIONED_MARKER"

# Any boot without a release, so a failed bootstrap retries on the next reboot.
if [[ ! -e ${app_path}/current ]]; then
	bootstrap_release || echo "Release bootstrap failed; run Deploy, or reboot to retry."
fi
mark_ready

echo "===== Startup Script Complete ====="

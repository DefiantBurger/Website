limit_req_zone $http_cf_connecting_ip zone=limit:10m rate=10r/s;
# Concurrent uploads, per visitor and in total. Each one in flight sits on disk up to four
# times (Nginx's buffer, Waitress's, Werkzeug's spool, the encrypted copy), so without a
# cap a couple dozen at once fill the boot disk.
limit_conn_zone $http_cf_connecting_ip zone=uploads_per_ip:1m;
limit_conn_zone $server_name zone=uploads_total:1m;

# Always revalidate HTML (the SPA shell and its per-route copies) so browsers never
# reuse one that points at a previous release's assets.
map $sent_http_content_type $html_expires {
	~^text/html epoch;
	default off;
}

# Only cloudflared on this VM connects here. Cloudflare terminates TLS for
# visitors, and the tunnel encrypts traffic between Cloudflare and the VM.
server {
	# A reload can't rebind this to another address (the startup script reloads), so after
	# changing it, also run `systemctl restart nginx` on the VM.
	listen 127.0.0.1:80;
	server_name ${domain};
	# Server level: Debian 13's nginx.conf already sets it at http level, and a second one there fails nginx -t.
	server_tokens off;
	root ${app_path}/current/frontend/dist;
	index index.html;

	client_max_body_size 1M;

	# Debian's default only compresses text/html. Build assets come precompressed
	# (gzip_static below); this covers the rest. `any` because requests via Cloudflare may carry Via.
	gzip on;
	gzip_proxied any;
	gzip_vary on;
	gzip_types application/json text/css application/javascript image/svg+xml;

	# `expires` rather than add_header, so the security headers below still apply.
	expires $html_expires;

	# 429 rather than the default 503, so rate limiting doesn't look like an outage.
	limit_req_status 429;
	limit_conn_status 429;

	# CF-Visitor carries the visitor's original scheme through the tunnel.
	if ($http_cf_visitor ~ '"scheme":"http"') {
		return 301 https://$host$request_uri;
	}

	# These apply to every location below, as long as none of them sets its own add_header.
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
	add_header Cross-Origin-Opener-Policy "same-origin" always;
	# style-src needs 'unsafe-inline' for Mermaid diagrams and Svelte transitions;
	# img-src allows the About You map's tiles.
	add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

	# Rate-limit the API only: a page load requests ~20 assets at once, which
	# would trip the limit on a cold Cloudflare cache.
	location /api/ {
		include api_proxy_params.conf;
		limit_req zone=limit burst=10 delay=5;
	}

	location /api/fileshare/ {
		include api_proxy_params.conf;
		limit_req zone=limit burst=10 nodelay;
	}

	location /api/fileshare/upload/ {
		include api_proxy_params.conf;
		limit_req zone=limit burst=10 nodelay;
		# Keep request buffering on: it stops slow uploads from tying up Waitress's threads.
		limit_conn uploads_per_ip 2;
		limit_conn uploads_total 6;
		client_max_body_size 81M;
	}

	# Vite content-hashes these filenames, so cache them forever. A missing asset
	# (e.g. requested by a stale index.html) must 404: the SPA fallback would serve
	# HTML, which nosniff makes the browser reject as CSS/JS.
	# `expires` rather than add_header, so the security headers above still apply.
	location /assets/ {
		try_files $uri =404;
		expires max;
		# The build writes a .gz next to each text asset (plugins/precompress.ts).
		gzip_static on;
	}

	# The build writes the SPA shell to <route>/index.html for every real route
	# (plugins/routeHtml.ts), so anything else is a real 404 for crawlers. The 404 body is
	# still the shell, so visitors see the app's own not-found page.
	location / {
		# One URL per page, so crawlers don't index duplicates. Absolute target, since
		# Nginx itself sees plain http and would otherwise redirect to http://.
		rewrite ^(.+)/$ https://$host$1 permanent;
		try_files $uri $uri/index.html =404;
	}

	error_page 404 /404.html;
	location = /404.html {
		internal;
	}
}

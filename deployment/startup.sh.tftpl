#!/bin/bash

# google_metadata_script_runner already forwards stdout to the serial console,
# so only tee to the local log file to avoid every line appearing twice.
exec > >(tee -a /var/log/startup-script.log) 2>&1
set -euo pipefail

echo "===== Startup Script Begin ====="

# Provisioning runs on the first boot only. Releases are deployed by GitHub
# Actions (deploy.sh.tftpl); every boot refreshes secrets, and a boot without a
# release installs the last one Actions published (bootstrap_release).
PROVISIONED_MARKER=${data_path}/.provisioned

if [[ ! -f "$PROVISIONED_MARKER" ]]; then
	echo "[0/7] Pre-Setup: Removing man-db and cleaning up..."
	export DEBIAN_FRONTEND=noninteractive
	apt-get remove -y man-db
	apt-get autoremove -y

	echo "[1/7] Updating packages..."
	apt-get update -yq

	echo "[2/7] Installing base dependencies..."
	apt-get install -yq \
		python3.11 \
		python3.11-venv \
		python3 \
		nginx \
		curl \
		ca-certificates \
		gnupg \
		unattended-upgrades

	echo "[3/7] Verifying Python 3.11 runtime..."
	python3.11 --version

	echo "[4/7] Creating backend runtime user and directories..."
	if ! id -u flaskapp >/dev/null 2>&1; then
		useradd --system --no-create-home --shell /usr/sbin/nologin flaskapp
	fi
	# Releases are root-owned; flaskapp can only write its runtime data.
	install -d -m 755 -o root -g root ${app_path} ${app_path}/releases
	install -d -m 700 -o flaskapp -g flaskapp ${data_path}

	echo "[5/7] Installing the release deploy script..."
	printf "%s" "${deploy_script}" | base64 --decode > /usr/local/sbin/personalwebsite-deploy
	chown root:root /usr/local/sbin/personalwebsite-deploy
	chmod 755 /usr/local/sbin/personalwebsite-deploy

	# The GitHub deployer logs in through OS Login without admin rights; this is its only sudo.
	SUDOERS_TMP="$(mktemp)"
	printf "%s ALL=(root) NOPASSWD: /usr/local/sbin/personalwebsite-deploy\n" "${deployer_username}" > "$SUDOERS_TMP"
	visudo -cf "$SUDOERS_TMP"
	install -m 440 -o root -g root "$SUDOERS_TMP" /etc/sudoers.d/personalwebsite-deploy
	rm -f "$SUDOERS_TMP"

	echo "[6/7] Setting up Nginx reverse proxy and systemd units..."
	printf "%s" "${nginx_api_proxy_params}" | base64 --decode > /etc/nginx/api_proxy_params.conf
	printf "%s" "${nginx_conf}" | base64 --decode > /etc/nginx/sites-available/default
	nginx -t

	# flaskapp starts on the first deploy; its ConditionPathExists skips it until then.
	printf "%s" "${flaskapp_service}" | base64 --decode > /etc/systemd/system/flaskapp.service

	echo "[7/7] Installing Cloudflare Tunnel..."
	mkdir -p --mode=0755 /usr/share/keyrings
	curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg > /usr/share/keyrings/cloudflare-main.gpg
	echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared bookworm main" > /etc/apt/sources.list.d/cloudflared.list
	apt-get update -yq
	apt-get install -yq cloudflared

	# Lists append to Debian's 50unattended-upgrades (security only), adding point releases and cloudflared.
	# Reboots only when a package needs one (kernel, libc); the VM clock is UTC.
	cat > /etc/apt/apt.conf.d/52personalwebsite <<'EOF'
Unattended-Upgrade::Origins-Pattern {
	"origin=Debian,codename=$${distro_codename},label=Debian";
	"site=pkg.cloudflare.com";
};
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "09:00";
EOF

	# quic-go (used by cloudflared) wants ~7 MiB UDP buffers; the Debian default caps them at 208 KiB.
	cat > /etc/sysctl.d/99-cloudflared.conf <<'EOF'
net.core.rmem_max=7500000
net.core.wmem_max=7500000
EOF
	sysctl -p /etc/sysctl.d/99-cloudflared.conf

	printf "%s" "${cloudflared_service}" | base64 --decode > /etc/systemd/system/cloudflared.service

	# The cloudflared package never restarts the service, so an upgrade would otherwise wait for a reboot.
	cat > /etc/systemd/system/cloudflared-restart.path <<'EOF'
[Unit]
Description=Watch the cloudflared binary for upgrades

[Path]
PathChanged=/usr/bin/cloudflared

[Install]
WantedBy=multi-user.target
EOF
	cat > /etc/systemd/system/cloudflared-restart.service <<'EOF'
[Unit]
Description=Restart cloudflared after an upgrade

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl try-restart cloudflared.service
EOF

	systemctl daemon-reload
	systemctl enable flaskapp nginx cloudflared cloudflared-restart.path
else
	echo "Already provisioned; refreshing secrets only."
fi

# Every boot, so rotating a secret only needs a reboot.
echo "Fetching runtime secrets from Secret Manager..."
METADATA_HEADER="Metadata-Flavor: Google"
ACCESS_TOKEN="$(curl -fsS -H "$METADATA_HEADER" "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" | python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')"

fetch_secret_value() {
	local secret_name="$1"
	local secret_version="$2"
	local project_id_local
	project_id_local="$(curl -fsS -H "$METADATA_HEADER" "http://metadata.google.internal/computeMetadata/v1/project/project-id")"
	local url="https://secretmanager.googleapis.com/v1/projects/$project_id_local/secrets/$${secret_name}/versions/$${secret_version}:access"
	curl -fsS -H "Authorization: Bearer $ACCESS_TOKEN" "$url" | python3 -c 'import base64,json,sys; print(base64.b64decode(json.load(sys.stdin)["payload"]["data"]).decode("utf-8"), end="")'
}

# Write a secrets file; restart the unit only if the contents changed, since
# enabled units have already started with the previous file at this point.
install_secret_file() {
	local path="$1" owner="$2" mode="$3" unit="$4" content="$5"
	local tmp
	tmp="$(mktemp)"
	printf "%s\n" "$content" > "$tmp"
	chown "$owner" "$tmp"
	chmod "$mode" "$tmp"
	if [[ -f "$path" ]] && cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
	else
		mv "$tmp" "$path"
		systemctl try-restart "$unit"
	fi
}

mkdir -p /etc/personalwebsite /etc/cloudflared
install_secret_file /etc/personalwebsite/secrets.env root:flaskapp 640 flaskapp \
	"SECRET_KEY=$(fetch_secret_value "${secret_name_flask}" "${secret_version_flask}")"
install_secret_file /etc/cloudflared/tunnel.env root:root 600 cloudflared \
	"TUNNEL_TOKEN=$(fetch_secret_value "${secret_name_cloudflare_tunnel_token}" "latest")"

if [[ ! -f "$PROVISIONED_MARKER" ]]; then
	systemctl restart nginx
	systemctl start cloudflared
	touch "$PROVISIONED_MARKER"
fi

# Install the last release Deploy published (deploy.yaml), so a replaced VM
# serves the site without a manual deploy. Returns 0 if none is published yet.
bootstrap_release() {
	local object_url="https://storage.googleapis.com/storage/v1/b/${release_bucket}/o/latest.tar.gz"
	local auth="Authorization: Bearer $ACCESS_TOKEN"
	local info status fields sha checksum generation
	info="$(mktemp)"
	status="$(curl -sS -o "$info" -w '%%{http_code}' -H "$auth" "$object_url")"
	if [[ "$status" == 404 ]]; then
		echo "No release published to gs://${release_bucket} yet."
		rm -f "$info"
		return 0
	elif [[ "$status" != 200 ]]; then
		echo "Release lookup failed (HTTP $status): $(cat "$info")"
		rm -f "$info"
		return 1
	fi
	fields="$(python3 -c 'import json,sys; o=json.load(sys.stdin); m=o["metadata"]; print(m["git-sha"], m["sha256"], o["generation"])' < "$info")" || {
		rm -f "$info"
		return 1
	}
	rm -f "$info"
	read -r sha checksum generation <<< "$fields"

	# Pinned to the generation just read, so a concurrent deploy can't pair this
	# metadata with another release's bytes. The deploy script checks the checksum.
	echo "Installing published release $sha..."
	curl -fsS -H "$auth" "$object_url?alt=media&generation=$generation" \
		| /usr/local/sbin/personalwebsite-deploy "$sha" "$checksum"
}

# Any boot without a release, so a failed bootstrap retries on the next reboot.
if [[ ! -e ${app_path}/current ]]; then
	bootstrap_release || echo "Release bootstrap failed; run Deploy, or reboot to retry."
fi

echo "===== Startup Script Complete ====="

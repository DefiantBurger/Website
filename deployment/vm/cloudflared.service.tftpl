[Unit]
Description=Cloudflare Tunnel
After=network-online.target nginx.service
Wants=network-online.target
# Joining the tunnel puts this VM in Cloudflare's rotation, so only do it once a release
# is active. On a fresh VM, the deploy script starts it after a release's health check.
ConditionPathExists=${app_path}/current

[Service]
DynamicUser=yes
# Provides TUNNEL_TOKEN, which `cloudflared tunnel run` reads from the environment,
# keeping the token out of the process command line.
EnvironmentFile=/etc/cloudflared/tunnel.env
# A fixed metrics port, so the startup script can poll /ready (200 once connected).
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:20241 run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
